# Neovim
*.swp
*.swo

# Test/coverage output
luacov.stats.out
luacov.report.out

# Generated by :helptags; regenerated on demand
doc/tags

# Python tool caches — created by running the doc/lint checkers from
# ocrosby/claude-config with this repo as cwd. Each writes a
# self-ignoring .gitignore inside itself, so without these entries they
# stay invisible to `git status` while still sitting in the worktree.
.pytest_cache/
.ruff_cache/
__pycache__/

# Editor
.idea/
.vscode/

# macOS
.DS_Store
